{
  "tasks": {
    "setup": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/pre-push",
    "check": "deno fmt --check && deno lint && deno check src scripts",
    "test": "deno test -A",
    "pre-commit": "deno task check && deno task test",
    "pre-push": "deno task check && deno task test",
    "build": "deno run -A scripts/build.ts",
    "dev": "deno run -A scripts/dev.ts",
    "e2e": "deno task build && deno run -A scripts/e2e/diag.ts",
    "determinism": "deno run -A scripts/determinism.ts"
  },
  "imports": {
    "@/": "./src/",
    "ggwave": "npm:ggwave@^0.4.0",
    "qr": "npm:qr@^0.7.0",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/http": "jsr:@std/http@^1",
    "@std/path": "jsr:@std/path@^1",
    "playwright": "npm:playwright@^1.63"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext",
      "deno.ns"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "exclude": [
    "dist/",
    "node_modules/",
    ".claude/worktrees/"
  ],
  "nodeModulesDir": "auto"
}
